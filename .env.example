# =========================================================================
# DU LỊCH VĨNH LONG THÔNG MINH - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép tệp này thành .env hoặc cấu hình trực tiếp trên Dashboard của Render
# Tuyệt đối KHÔNG đưa mật khẩu hoặc API Key thật lên kho lưu trữ GitHub!
# =========================================================================

# 1. CỔNG MÁY CHỦ (Hosting Render tự động cấp biến PORT, mặc định 3000 khi chạy local)
PORT=3000
NODE_ENV=production

# 2. BẢO MẬT TÀI KHOẢN QUẢN TRỊ VIÊN (BẮT BUỘC ĐỂ ĐĂNG NHẬP CMS)
# Đặt tên tài khoản và mật khẩu an toàn theo ý của bạn.
# Nếu chưa cấu hình hai biến này, cổng đăng nhập sẽ tự động khóa để bảo vệ hệ thống.
ADMIN_USERNAME="admin_vinhlong"
ADMIN_PASSWORD="ThayDoiMatKhauBaoMat2026!"

# 3. CHỮ KÝ TOKEN XÁC THỰC HMAC-SHA256 (Tùy chọn nhưng khuyến nghị)
# Một chuỗi ký tự ngẫu nhiên dài từ 32 ký tự trở lên để ký token an toàn.
# Nếu không cung cấp, máy chủ sẽ tự động tạo một chuỗi ngẫu nhiên khi khởi động.
AUTH_SECRET="chuoi_bi_mat_ngau_nhien_dai_it_nhat_32_ky_tu_de_ky_token"

# 4. KẾT NỐI CƠ SỞ DỮ LIỆU ĐÁM MÂY SUPABASE (Tùy chọn - Lưu trữ bền vững trực tuyến)
# Tạo dự án miễn phí tại https://supabase.com và lấy URL & Service Role Key
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhGciOi..."

# 5. TRỢ LÝ TRÍ TUỆ NHÂN TẠO GEMINI AI (Tùy chọn)
# Tự động trích xuất tri thức từ kho dữ liệu du lịch địa phương đã kiểm chứng.
# Lấy API Key miễn phí tại https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 6. ĐƯỜNG DẪN ỨNG DỤNG (Tùy chọn - Dành cho AI Studio Cloud Run hoặc Render URL)
APP_URL="https://vinhlong-tourism.onrender.com"
